# =============================================================================
# OpsPilot AI — Environment Configuration
# Copy to .env and fill in values before running.
#
# Local Python (Windows):
#   cd apps\api
#   python -m venv venv
#   .\venv\Scripts\activate
#   pip install -r requirements.txt
# =============================================================================

# Application
APP_NAME=OpsPilot
APP_ENV=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Security
API_KEY=change-me-to-a-strong-secret
SECRET_KEY=change-me-jwt-or-session-secret

# PostgreSQL (+ pgvector)
# Host port 5433 — Docker maps 5433->5432 (avoids local Windows Postgres on 5432)
DATABASE_URL=postgresql+asyncpg://opspilot:opspilot@localhost:5433/opspilot
DATABASE_URL_SYNC=postgresql://opspilot:opspilot@localhost:5433/opspilot

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenAI (required for live LLM mode; leave blank to use deterministic mock agent)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Agent behaviour
AGENT_MODE=auto
# auto | openai | mock
MAX_TOOL_CALLS=12
EVIDENCE_SCORE_THRESHOLD=0.55

# Synthetic telemetry
TELEMETRY_MODE=synthetic
# synthetic | prometheus
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100

# OpenTelemetry (off by default for local; no collector required)
OTEL_ENABLED=false
OTEL_EXPORT_OTLP=false
OTEL_SERVICE_NAME=ops-pilot-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Frontend (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_KEY=change-me-to-a-strong-secret
